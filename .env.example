# 后台地址。留空时使用线上默认 API https://woai.info/admin/api。
# 本地预览后台请显式填写，例如 VITE_WB_ADMIN_URL=http://127.0.0.1:57900
VITE_WB_ADMIN_URL=
VITE_APP_VERSION=0.1.66

# Backend only, never expose this in the frontend build.
WB_ADMIN_MASTER_KEY=
# 短信验证码登录（阿里云号码认证服务 PNVS）。
# 三项必填才会真实下发；留空则回退本地调试验证码 123456。
# 短信配置也可以在后台「系统设置 → 阿里云短信登录」里填写（加密存库）；这里一旦填写就优先于后台页面。
WB_SMS_ACCESS_KEY_ID=
WB_SMS_ACCESS_KEY_SECRET=
WB_SMS_SIGN_NAME=
WB_SMS_TEMPLATE_CODE=100001
WB_SMS_SCHEME_NAME=
WB_SMS_ENDPOINT=dypnsapi.aliyuncs.com
# dev = 强制本地验证码，production = 未配置时直接报错
WB_SMS_MODE=
